meta {
  name: Update
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/doctors/{{doctorId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "specialtyId": 1,
    "departmentId": 1,
    "consultationFee": 75,
    "bio": "Cardiologue interventionnel",
    "isAcceptingPatients": true
  }
}

assert {
  res.status: eq 200
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);
  
  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Update

  `PATCH {{baseUrl}}/api/doctors/{{doctorId}}`

  Mise à jour partielle du profil médecin ; le compte utilisateur lié n'est pas modifié.

  **Authentification** : `Authorization: Bearer {{accessToken}}`

  **Réponse attendue** : 200 — enveloppe `{ data: ... }` (ou fichier binaire pour PDF/CSV)

  **Contrôles automatiques** : assertion de statut + test `statut 2xx` + test d’enveloppe JSON (ignoré pour 204 et les fichiers).
}
