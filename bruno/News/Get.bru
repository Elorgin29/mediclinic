meta {
  name: Get
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/news/{{newsId}}
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);

  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Get

  `GET {{baseUrl}}/api/news/{{newsId}}`

  Détail complet d'un article, y compris les brouillons.

  **Authentification** : `news:read`

  **Réponse attendue** : 200 — `{ data: NewsArticle }`
}
