meta {
  name: Public Get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/news/public/{{newsSlug}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);

  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Public Get

  `GET {{baseUrl}}/api/news/public/{{newsSlug}}`

  Détail d'un article publié par son slug. Aucune authentification requise.

  **Authentification** : publique

  **Réponse attendue** : 200 — `{ data: NewsArticle }` ; 404 si l'article n'existe pas ou n'est pas publié.
}
