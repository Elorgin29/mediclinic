meta {
  name: Create
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/news
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Nouvel article de la clinique",
    "category": "Actualités",
    "excerpt": "Un résumé de quelques lignes pour présenter cet article aux visiteurs du site.",
    "content": ["Premier paragraphe de l'article.", "Deuxième paragraphe avec des informations utiles."],
    "keyPoints": ["Premier point clé", "Deuxième point clé"],
    "author": "Équipe MediClinic",
    "status": "PUBLISHED"
  }
}

assert {
  res.status: eq 201
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);

  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Create

  `POST {{baseUrl}}/api/news`

  Crée un article. Le `slug` est généré automatiquement depuis le titre et rendu unique.
  `status` vaut `DRAFT` par défaut ; au passage en `PUBLISHED`, `publishedAt` est renseigné automatiquement.

  **Authentification** : `news:create`

  **Réponse attendue** : 201 — `{ data: NewsArticle }`
}
