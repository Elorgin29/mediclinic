meta {
  name: List
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/news?limit=20
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);

  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### List

  `GET {{baseUrl}}/api/news?limit=20&status=PUBLISHED&category=Prévention&search=...`

  Liste paginée d'administration, brouillons inclus. Filtres optionnels : `status` (`DRAFT`/`PUBLISHED`), `category`, `search`.

  **Authentification** : `news:read`

  **Réponse attendue** : 200 — `{ data: [...], meta: {...} }`
}
