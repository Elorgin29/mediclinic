meta {
  name: Get Dictionary
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/i18n?locale=en
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);

  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Get Dictionary

  `GET {{baseUrl}}/api/i18n?locale=fr|en|mg`

  Retourne le dictionnaire fusionné (locale demandée + repli français). Aucune authentification requise.
}
