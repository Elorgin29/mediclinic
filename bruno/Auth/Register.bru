meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nouveau.patient@email.fr",
    "password": "Passw0rd!2026",
    "confirmPassword": "Passw0rd!2026",
    "firstName": "Nouveau",
    "lastName": "Patient",
    "birthDate": "1990-01-01",
    "gender": "MALE",
    "phone": "0612345678",
    "address": "1 rue de Paris",
    "city": "Paris",
    "postalCode": "75001"
  }
}

assert {
  res.status: eq 201
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);
  
  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Register

  `POST {{baseUrl}}/api/auth/register`

  Inscription en ligne d'un patient : création du compte et du dossier dans une transaction. Public. Réponse 201 `{ data: session }`.

  **Authentification** : publique / optionnelle

  **Réponse attendue** : 201 — enveloppe `{ data: ... }` (ou fichier binaire pour PDF/CSV)

  **Contrôles automatiques** : assertion de statut + test `statut 2xx` + test d’enveloppe JSON (ignoré pour 204 et les fichiers).
}
