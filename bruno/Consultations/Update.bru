meta {
  name: Update
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/consultations/{{consultationId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "diagnosis": "Hypertension artérielle essentielle stade 1",
    "notes": "Traitement ajusté",
    "followUpAt": "2026-12-25"
  }
}

assert {
  res.status: eq 200
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);
  
  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Update

  `PATCH {{baseUrl}}/api/consultations/{{consultationId}}`

  Mise à jour du diagnostic, des notes ou de la date de suivi (médecin auteur uniquement).

  **Authentification** : `Authorization: Bearer {{accessToken}}`

  **Réponse attendue** : 200 — enveloppe `{ data: ... }` (ou fichier binaire pour PDF/CSV)

  **Contrôles automatiques** : assertion de statut + test `statut 2xx` + test d’enveloppe JSON (ignoré pour 204 et les fichiers).
}
