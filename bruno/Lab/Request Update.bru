meta {
  name: Request Update
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/lab/requests/{{labRequestId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "status": "COMPLETED",
    "resultText": "Glycémie à jeun : 0,92 g/L — valeurs de référence."
  }
}

assert {
  res.status: eq 200
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);
  
  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Request Update

  `PATCH {{baseUrl}}/api/lab/requests/{{labRequestId}}`

  Saisie du statut et du résultat ; `completed_at` est renseigné automatiquement en cas de COMPLETED.

  **Authentification** : `Authorization: Bearer {{accessToken}}`

  **Réponse attendue** : 200 — enveloppe `{ data: ... }` (ou fichier binaire pour PDF/CSV)

  **Contrôles automatiques** : assertion de statut + test `statut 2xx` + test d’enveloppe JSON (ignoré pour 204 et les fichiers).
}
