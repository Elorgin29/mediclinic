meta {
  name: Update
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/settings
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Clinique MediClinic",
    "address": "12 avenue de la Santé, 75015 Paris, France",
    "phone": "+33 1 45 67 89 00",
    "email": "contact@mediclinic.fr",
    "currency": "EUR",
    "vatRate": 20
  }
}

assert {
  res.status: eq 200
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);
  
  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Update

  `PATCH {{baseUrl}}/api/settings`

  Mise à jour partielle des paramètres de la clinique, y compris les credentials Zoom.

  **Authentification** : `Authorization: Bearer {{accessToken}}`

  **Réponse attendue** : 200 — enveloppe `{ data: ... }` (ou fichier binaire pour PDF/CSV)

  **Contrôles automatiques** : assertion de statut + test `statut 2xx` + test d’enveloppe JSON (ignoré pour 204 et les fichiers).
}
