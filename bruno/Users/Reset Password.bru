meta {
  name: Reset Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/users/{{userId}}/reset-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "password": "Passw0rd!2026"
  }
}

assert {
  res.status: eq 204
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);
  
  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Reset Password

  `POST {{baseUrl}}/api/users/{{userId}}/reset-password`

  Réinitialisation du mot de passe d'un utilisateur. Si `password` est omis, un mot de passe de démonstration est généré. Réponse 204.

  **Authentification** : `Authorization: Bearer {{accessToken}}`

  **Réponse attendue** : 204 sans contenu

  **Contrôles automatiques** : assertion de statut + test `statut 2xx` + test d’enveloppe JSON (ignoré pour 204 et les fichiers).
}
