meta {
  name: Create
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/appointments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "patientId": 5,
    "doctorId": 3,
    "departmentId": 2,
    "scheduledAt": "2026-12-03 10:00:00",
    "duration": 30,
    "type": "IN_PERSON",
    "reason": "Consultation de suivi",
    "notes": "Patient connu"
  }
}

assert {
  res.status: eq 201
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);
  
  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Create

  `POST {{baseUrl}}/api/appointments`

  Création d'un rendez-vous interne ; une réunion Zoom est créée automatiquement pour un type TELEMEDICINE. Conflit de créneau → 409.

  **Authentification** : `Authorization: Bearer {{accessToken}}`

  **Réponse attendue** : 201 — enveloppe `{ data: ... }` (ou fichier binaire pour PDF/CSV)

  **Contrôles automatiques** : assertion de statut + test `statut 2xx` + test d’enveloppe JSON (ignoré pour 204 et les fichiers).
}
