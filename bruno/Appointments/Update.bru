meta {
  name: Update
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/appointments/{{appointmentId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "doctorId": 3,
    "scheduledAt": "2026-12-03 11:00:00",
    "duration": 45,
    "notes": "Replanifié"
  }
}

assert {
  res.status: eq 200
}

tests {
  const body = res.getBody();
  const isJson = body && typeof body === "object" && !Array.isArray(body) && !Buffer.isBuffer(body);
  
  test("statut 2xx", () => expect(res.status).to.be.within(200, 299));
  if (res.status !== 204 && isJson) {
    test("enveloppe data", () => expect(body).to.have.property("data"));
  }
}

docs {
  ### Update

  `PATCH {{baseUrl}}/api/appointments/{{appointmentId}}`

  Modification ou replanification d'un rendez-vous.

  **Authentification** : `Authorization: Bearer {{accessToken}}`

  **Réponse attendue** : 200 — enveloppe `{ data: ... }` (ou fichier binaire pour PDF/CSV)

  **Contrôles automatiques** : assertion de statut + test `statut 2xx` + test d’enveloppe JSON (ignoré pour 204 et les fichiers).
}
