# =============================================================================
# MediClinic — modèle de configuration d'environnement
# Copier ce fichier vers .env puis adapter les valeurs.
#   Windows : copy .env.example .env
#   Unix    : cp .env.example .env
# ATTENTION : .env ne doit JAMAIS être commité.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=MediClinic
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
# Origines autorisées par CORS (liste séparée par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Base de données MySQL 8
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mediclinic
DB_PASSWORD=mediclinic
DB_NAME=mediclinic
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Compte root utilisé uniquement par docker-compose (création du schéma)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=mediclinic
MYSQL_USER=mediclinic
MYSQL_PASSWORD=mediclinic

# -----------------------------------------------------------------------------
# JWT — HS256. ACCESS_TOKEN_SECRET doit faire >= 64 caractères.
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=change_me_access_secret_at_least_64_characters_long_0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=change_me_refresh_secret_at_least_64_characters_long_0123456789abcdef
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Sécurité applicative
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
UPLOAD_MAX_SIZE_MB=5

# -----------------------------------------------------------------------------
# Emails (nodemailer) — en dev, MailHog via docker-compose
# -----------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MediClinic <no-reply@mediclinic.local>"

# -----------------------------------------------------------------------------
# Clinique (paramètres par défaut utilisés par les PDF)
# -----------------------------------------------------------------------------
CLINIC_NAME=Clinique MediClinic
CLINIC_ADDRESS=12 avenue de la Santé, 75012 Paris
CLINIC_PHONE=+33 1 23 45 67 89
CLINIC_EMAIL=contact@mediclinic.local
CLINIC_CURRENCY=EUR
CLINIC_VAT_RATE=20

# -----------------------------------------------------------------------------
# Zoom — OAuth Server-to-Server
# Créer une app "Server-to-Server OAuth" sur https://marketplace.zoom.us
# Scopes requis : meeting:write:meeting:admin, meeting:read:meeting:admin,
#                 meeting:delete:meeting:admin, user:read:user:admin
# -----------------------------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# -----------------------------------------------------------------------------
# Seed / démonstration (utilisé par database/scripts/reset-db.sh)
# -----------------------------------------------------------------------------
SEED_DEFAULT_PASSWORD=Passw0rd!2026
